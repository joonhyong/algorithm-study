/**
 * 문제명: 두 수의 나눗셈
 * 사이트: Programmers
 * 레벨: Level 0
 * 날짜: 2026-08-02
 *
 * 풀이
 * - 반환할 연산 결과 값을 저장할 변수를 0으로 초기화
 * - 해당 변수에 아래의 과정을 수행
 *   -> 두 인수의 나눗셈 수행
 *   -> 나눗셈 결과물에 1000 곱하기 수행
 *   -> 해당 결과물에 Math.floor() 메서드 적용
 *
 * 시간복잡도
 * - O(1)
 * - 두 수가 BigInt 처리가 필요 없는 일반적인 숫자 범위 내에 있으면서
 * - 입력값 크기에 상관없이 나눗셈, 곱셈, Math.floor() 연산이 항상 일정한 횟수로만 수행됨
 *
 * 알게 된 점
 * - 입력 값의 크기, 데이터의 개수가 커지면 일반적으로 연산 횟수가 늘어나 시간복잡도에 영향을 줌
 * - 하지만 해당 문제에서는 입력값에 상관없이 연산 횟수가 일정하므로, 시간 복잡도는 O(1) 임
 * - JavaSCript에서는 BigInt 연산이 필요한 극단적 큰 수가 아니라면, Number 범위 내의 산술 연산은 모두 O(1)로 처리 됨
 */

function solution(num1, num2) {
  let answer = 0;
  answer = Math.floor((num1 / num2) * 1000);
  return answer;
}

console.log(solution(7, 3));
